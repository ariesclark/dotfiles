{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DO_NOT_TRACK": "0"
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "/home/aries/.config/lnk/.claude/statusline.sh",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "prior-art@ariesclark": true,
    "humanizer@ariesclark": true,
    "sentry-cli@claude-plugins-official": true,
    "guardrails@ariesclark": true,
    "github@ariesclark": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "why@ariesclark": true,
    "writing-skills@ariesclark": true,
    "pulumi@pulumi-agent-skills": true,
    "writing@ariesclark": true,
    "papercuts@ariesclark": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "ariesclark": {
      "source": {
        "source": "directory",
        "path": "/home/aries/skills"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/ast-grep/agent-skill.git"
      }
    },
    "pulumi-agent-skills": {
      "source": {
        "source": "github",
        "repo": "pulumi/agent-skills"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "remoteControlAtStartup": true
}
