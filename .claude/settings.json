{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DO_NOT_TRACK": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ],
    "deny": [
      "Read(*.env)",
      "Bash(rm:*)",
      "Bash(gh pr create:*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "/home/aries/.config/lnk/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "github@ariesclark": true,
    "guardrails@ariesclark": true,
    "papercuts@ariesclark": true,
    "plugin-dev@claude-plugins-official": true,
    "prior-art@ariesclark": true,
    "pulumi@pulumi-agent-skills": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sentry-cli@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "why@ariesclark": true,
    "writing@ariesclark": true,
    "kagi@kagi-cli": true
  },
  "extraKnownMarketplaces": {
    "ariesclark": {
      "source": {
        "source": "directory",
        "path": "/home/aries/skills"
      },
      "autoUpdate": true
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/ast-grep/agent-skill.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "pulumi-agent-skills": {
      "source": {
        "source": "github",
        "repo": "pulumi/agent-skills"
      }
    },
    "kagi-cli": {
      "source": {
        "source": "directory",
        "path": "/home/aries/kagi-cli"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never use `rm`, use `trash` instead.",
      "Never write a scratch file to a bare path in a system temp directory, and never write one outside the session scratch directory. Scratch goes in `.claude/tmp/<friendly-name>/`, which is a symlink to a `mktemp -d -t \"<friendly-name>.XXXXXX\"` directory, so the work stays visible in the user's editor. Creating that directory and writing inside it is expected; writing to `/tmp/<file>` directly is not.",
      "Never edit a tracked config file at its symlink target under `~`. Edit it in the `~/.config/lnk` repo instead.",
      "Never disable or bypass git commit signing: no `--no-gpg-sign`, no `-c commit.gpgsign=false`, no `git config` write that turns signing off.",
      "Never create a pull request. This covers `gh pr create` and any equivalent API call, such as `gh api` or `curl` POSTing to a `/pulls` endpoint."
    ]
  }
}
