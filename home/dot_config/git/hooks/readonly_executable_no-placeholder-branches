#!/bin/sh

if default_branch=$(git symbolic-ref --quiet --short "refs/remotes/$1/HEAD" 2>/dev/null); then
	default_branch=${default_branch#"$1"/}
else
	default_branch="the default branch"
fi

blocked=0
while read -r local_ref local_oid remote_ref remote_oid; do
	case "$remote_ref" in
	refs/heads/ai/* | refs/heads/claude/* | refs/heads/codex/* | refs/heads/copilot/* | refs/heads/cursor/* | refs/heads/devin/*) ;;
	*) continue ;;
	esac
	case "$local_oid" in
	*[!0]*) ;;
	*) continue ;;
	esac
	blocked=1
	remote_branch=${remote_ref#refs/heads/}
	cat >&2 <<-EOF
		no-placeholder-branches: refusing to push $remote_branch to $1.

		In every repository, the user prefers pushing straight to $default_branch unless that is disallowed or against its conventions. Otherwise, name the branch for the change, following those conventions if any (e.g. fix/login-redirect).
	EOF
done

exit "$blocked"
