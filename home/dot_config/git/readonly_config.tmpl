{{ includeTemplate "generated" . }}
[user]
{{- if lookPath .chezmoi.config.onepassword.command }}
	name = {{ onepasswordRead "op://personal/6enz7r76cvm7nq3gac2xckcxke/Identification/first name" }} {{ onepasswordRead "op://personal/6enz7r76cvm7nq3gac2xckcxke/Identification/last name" }}
	email = {{ onepasswordRead "op://personal/6enz7r76cvm7nq3gac2xckcxke/Internet Details/email" }}
	signingkey = {{ onepasswordRead "op://personal/rczscaa2ex5o5gqxuoo5aa6xmu/public key" }}
{{- end }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
[url "https://github.com/"]
	insteadOf = git@github.com:
{{- $gitVersionParts := output "git" "--version" | trim | splitList " " | last | splitList "." }}
{{- $gitVersion := slice $gitVersionParts 0 3 | join "." }}
{{- if semverCompare "<2.54.0" $gitVersion }}
{{-   fail (printf "git %s is too old: hooks defined in config (hook.<name>.command) need git 2.54.0 or later. Upgrade git, then apply again." $gitVersion) }}
{{- end }}
[hook "no-placeholder-branches"]
	command = ~/.config/git/hooks/no-placeholder-branches
	event = pre-push
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- if eq .chezmoi.os "windows" }}
[gpg "ssh"]
	program = {{ joinPath .chezmoi.homeDir "AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe" | replace "\\" "/" }}
[core]
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- else if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
[gpg "ssh"]
	program = op-ssh-sign-wsl.exe
[core]
	sshCommand = ssh.exe
{{- end }}
