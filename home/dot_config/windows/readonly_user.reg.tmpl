Windows Registry Editor Version 5.00
{{ includeTemplate "generated" . }}

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run]
{{- range $id, $app := .apps }}
{{-   if and (hasPrefix "scoop:" $id) (hasKey $app "startup") }}
{{-     $current := joinPath $.system.install.scoop "apps" (index (splitList "/" $id) 1) "current" }}
{{-     range $app.startup }}
{{-       $path := .path }}
{{-       if not (regexMatch "^[A-Za-z]:" $path) }}{{ $path = joinPath $current $path }}{{ end }}
{{-       if stat $path }}
{{-         $command := printf "\"%s\"" $path }}
{{-         if hasKey . "arguments" }}{{ $command = printf "%s %s" $command .arguments }}{{ end }}
"{{ .name }}"="{{ $command | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- range $id, $app := .apps }}
{{-   if and (hasPrefix "scoop:" $id) (hasKey $app "protocols") }}
{{-     $current := joinPath $.system.install.scoop "apps" (index (splitList "/" $id) 1) "current" }}
{{-     range $app.protocols }}
{{-       $path := .path }}
{{-       if not (regexMatch "^[A-Za-z]:" $path) }}{{ $path = joinPath $current $path }}{{ end }}
{{-       if stat $path }}
{{-         $escaped := $path | replace "\\" "\\\\" }}

[HKEY_CURRENT_USER\Software\Classes\{{ .name }}]
@="URL:{{ .name }} Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\{{ .name }}\DefaultIcon]
@="{{ $escaped }}"

[HKEY_CURRENT_USER\Software\Classes\{{ .name }}\Shell\Open\Command]
@="{{ printf "\"%s\" %s" $path .arguments | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- with .system.wsl }}

[HKEY_CURRENT_USER\Network\{{ upper .drive }}]
"RemotePath"="{{ printf "\\\\wsl.localhost\\%s" .distribution | replace "\\" "\\\\" }}"
"UserName"=dword:00000000
"ProviderName"="Plan 9 Network Provider"
"ProviderType"=dword:00480000
"ConnectionType"=dword:00000001
"DeferFlags"=dword:00000004
{{- end }}
{{- if hasKey .apps "scoop:extras/windirstat" }}
{{-   $drives := list }}
{{-   range $letter := keys .system.volumes | sortAlpha }}{{ $drives = append $drives (printf "%s:" (upper $letter)) }}{{ end }}
{{-   with .system.wsl }}{{ $drives = append $drives (printf "%s:" (upper .drive)) }}{{ end }}

[HKEY_CURRENT_USER\Software\WinDirStat\WinDirStat\DriveSelect]
"SelectDrivesRadio"=dword:00000001
"SelectDrivesDrives"="{{ $drives | sortAlpha | join "|" }}"

[HKEY_CURRENT_USER\Software\WinDirStat\WinDirStat\TreeMapView]
"TreeMapUseLogicalSize"=dword:00000001
{{- end }}
