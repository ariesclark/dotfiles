{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
Import-Module '{{ joinPath .chezmoi.workingTree "windows" "volumes.psm1" }}' -Force
$volumes = @'
{{ .system.volumes | toJson }}
'@ | ConvertFrom-Json
$layout = ConvertTo-Layout -Volumes $volumes -SystemLetter $env:SystemDrive
Sync-Partition -Layout $layout -OptedIn ${{ .machine.partition }}
{{ end -}}
