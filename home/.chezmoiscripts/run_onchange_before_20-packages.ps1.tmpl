{{ if eq .chezmoi.os "windows" -}}
# reruns when windows/ changes: {{ template "glob-hash" (joinPath .chezmoi.workingTree "windows" "*.psm1") }}
$ErrorActionPreference = 'Stop'
Import-Module '{{ joinPath .chezmoi.workingTree "windows" "packages.psm1" }}' -Force
$groups = @'
{{ .groups | toJson }}
'@ | ConvertFrom-Json
$apps = @'
{{ .apps | toJson }}
'@ | ConvertFrom-Json
$selected = @'
{{ .machine.groups | toJson }}
'@ | ConvertFrom-Json
$layout = @'
{{ (pick .layout "scoop" "state" "winget") | toJson }}
'@ | ConvertFrom-Json
Sync-Package -Groups $groups -Apps $apps -Selected $selected -Layout $layout
{{ end -}}
