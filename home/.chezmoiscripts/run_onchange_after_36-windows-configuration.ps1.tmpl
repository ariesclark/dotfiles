{{ if eq .chezmoi.os "windows" -}}
# reruns when the file changes: {{ includeTemplate "dot_config/windows/readonly_configuration.winget.tmpl" . | sha256sum }}
$ErrorActionPreference = 'Stop'
$modules = '{{ .system.install.configurationModules }}'
New-Item -ItemType Directory -Force -Path $modules | Out-Null
$pinned = [ordered]@{ 'Microsoft.Windows.Developer' = '0.4.0-alpha'; 'PSDscResources' = '2.12.0.0'; 'PSDesiredStateConfiguration' = '2.0.8' }
foreach ($name in $pinned.Keys) {
	$version = $pinned[$name]
	if (-not (Test-Path -LiteralPath (Join-Path $modules "$name\$($version.Split('-')[0])"))) {
		pwsh -NoProfile -Command "Save-PSResource -Name '$name' -Version '$version' -Prerelease -Repository PSGallery -TrustRepository -Path '$modules'"
		if ($LASTEXITCODE) {
			throw "Could not save $name $version."
		}
	}
}
winget configure --enable
if ($LASTEXITCODE) {
	throw 'Could not turn on winget configure.'
}
winget configure --file '{{ joinPath .chezmoi.homeDir ".config" "windows" "configuration.winget" }}' --module-path $modules --accept-configuration-agreements --disable-interactivity
if ($LASTEXITCODE) {
	throw 'winget configure failed.'
}
{{ end -}}
