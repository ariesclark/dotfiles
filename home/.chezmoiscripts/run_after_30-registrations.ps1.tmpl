{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
Import-Module '{{ joinPath .chezmoi.workingTree "windows" "registrations.psm1" }}' -Force
$apps = @'
{{ .apps | toJson }}
'@ | ConvertFrom-Json
$install = @'
{{ .system.install | toJson }}
'@ | ConvertFrom-Json
Sync-Registration -Apps $apps -Install $install
{{ end -}}
