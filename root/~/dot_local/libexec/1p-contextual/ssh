#!/bin/sh
for remote_command; do :; done
case "$remote_command" in
"git-receive-pack '"*) ;;
*) exec "$@" ;;
esac
CONTEXTUAL_BUFFER=
CONTEXTUAL_REMOTE=
CONTEXTUAL_REPOSITORY=${remote_command#"git-receive-pack '"}
CONTEXTUAL_REPOSITORY=${CONTEXTUAL_REPOSITORY%"'"}
CONTEXTUAL_REPOSITORY=${CONTEXTUAL_REPOSITORY#/}
CONTEXTUAL_REPOSITORY=${CONTEXTUAL_REPOSITORY%.git}
export CONTEXTUAL_BUFFER CONTEXTUAL_REMOTE CONTEXTUAL_REPOSITORY
exec sh "${0%/*}/run" "$@"
