#!/bin/sh
release=
read -r release 2> /dev/null < /proc/sys/kernel/osrelease
case "$release" in
*[Mm]icrosoft*) wsl=true ;;
*) wsl=false ;;
esac
if [ "$1" != -Y ] || [ "$2" != sign ]; then
	if "$wsl"; then
		exec op-ssh-sign-wsl.exe "$@"
	fi
	exec op-ssh-sign.exe "$@"
fi
if "$wsl"; then
	count=$#
	index=0
	previous=
	for argument; do
		shift
		index=$((index + 1))
		if [ "$previous" = -f ] || [ "$index" -eq "$count" ]; then
			set -- "$@" "$(wslpath -w "$argument")"
		else
			set -- "$@" "$argument"
		fi
		previous=$argument
	done
fi
for CONTEXTUAL_BUFFER; do :; done
CONTEXTUAL_REMOTE=$(git remote get-url origin 2> /dev/null)
CONTEXTUAL_REPOSITORY=$(git rev-parse --path-format=absolute --git-common-dir)
CONTEXTUAL_REPOSITORY=${CONTEXTUAL_REPOSITORY%/.git}
CONTEXTUAL_REPOSITORY=${CONTEXTUAL_REPOSITORY##*/}
export CONTEXTUAL_BUFFER CONTEXTUAL_REMOTE CONTEXTUAL_REPOSITORY
exec sh "${0%/*}/run" "${OP_SSH_SIGN_CONTEXTUAL_PROGRAM:-op-ssh-sign.exe}" "$@"
