#!/bin/sh
CONTEXTUAL_PROGRAM=$1
shift
CONTEXTUAL_CHECKOUT=$(git rev-parse --show-toplevel)
CONTEXTUAL_CHECKOUT=${CONTEXTUAL_CHECKOUT##*/}
CONTEXTUAL_BRANCH=$(git branch --show-current)
CONTEXTUAL_ARGUMENTS=$(printf '%s\n' "$@")
WSLENV="${WSLENV:+$WSLENV:}CONTEXTUAL_BUFFER:CONTEXTUAL_REMOTE:CONTEXTUAL_REPOSITORY:CONTEXTUAL_CHECKOUT:CONTEXTUAL_BRANCH:CONTEXTUAL_PROGRAM:CONTEXTUAL_ARGUMENTS"
export CONTEXTUAL_BUFFER CONTEXTUAL_REMOTE CONTEXTUAL_REPOSITORY CONTEXTUAL_CHECKOUT CONTEXTUAL_BRANCH CONTEXTUAL_PROGRAM CONTEXTUAL_ARGUMENTS WSLENV
exec powershell.exe -NoProfile -NonInteractive -Command '
	$ErrorActionPreference = "Stop"
	$repository = $env:CONTEXTUAL_REPOSITORY
	$tag = $null
	$subject = $null
	if ($env:CONTEXTUAL_BUFFER) {
		$remote = $null
		if ([uri]::TryCreate([string] $env:CONTEXTUAL_REMOTE, [UriKind]::Absolute, [ref] $remote) -and $remote.Host) {
			$repository = $remote.AbsolutePath.Trim("/")
			if ($repository.EndsWith(".git")) {
				$repository = $repository.Substring(0, $repository.Length - 4)
			}
		}
		$lines = [IO.File]::ReadAllLines($env:CONTEXTUAL_BUFFER)
		$body = [array]::IndexOf($lines, "")
		if ($body -gt 0) {
			foreach ($header in $lines | Select-Object -First $body) {
				if ($header.StartsWith("tag ")) {
					$tag = $header.Substring(4)
				}
			}
			if ($body + 1 -lt $lines.Count) {
				$subject = $lines[$body + 1]
			}
		}
	}
	$branch = $env:CONTEXTUAL_BRANCH
	if ($tag) {
		$branch = $null
	}
	$place = $repository
	if ($branch) {
		$place += "$([char] 0xA789)$branch"
	}
	$redundant = @(($repository -split "/")[-1], $branch, ($branch -split "/")[-1])
	if ($env:CONTEXTUAL_CHECKOUT -and $redundant -notcontains $env:CONTEXTUAL_CHECKOUT) {
		$place += " ($env:CONTEXTUAL_CHECKOUT)"
	}
	$quoted = ""
	if ($subject) {
		if ($subject.Length -gt 60) {
			$subject = $subject.Substring(0, 59) + [char] 0x2026
		}
		$quoted = " $([char] 0x201C)$subject$([char] 0x201D)"
	}
	if (-not $env:CONTEXTUAL_BUFFER) {
		$name = "a push to $place"
	} elseif ($tag) {
		$name = "signing tag $tag$quoted in $place"
	} else {
		$name = "signing$quoted in $place"
	}
	$name = $name.Replace("/", [string] [char] 0x2215).Replace(":", [string] [char] 0xA789)
	foreach ($character in [IO.Path]::GetInvalidFileNameChars()) {
		$name = $name.Replace([string] $character, "-")
	}
	if ($name.Length -gt 120) {
		$name = $name.Substring(0, 119) + [char] 0x2026
	}
	$directory = Join-Path (Join-Path $env:TEMP "1p-contextual") $PID
	$null = New-Item -ItemType Directory -Force -Path $directory
	$supervisor = Join-Path $directory "$name.exe"
	Copy-Item -LiteralPath (Join-Path $PSHOME "powershell.exe") -Destination $supervisor
	$commandLine = foreach ($argument in $env:CONTEXTUAL_ARGUMENTS -split "`n") {
		if ($argument -and $argument -notmatch "[\s`"]") {
			$argument
		} else {
			$escaped = [regex]::Replace($argument, "(\\*)`"", "`$1`$1\`"")
			"`"$([regex]::Replace($escaped, "(\\+)$", "`$1`$1"))`""
		}
	}
	$release = New-Object Threading.EventWaitHandle $false, ([Threading.EventResetMode]::ManualReset), "Local\1p-contextual-$PID"
	$supervise = "
		`$release = [Threading.EventWaitHandle]::OpenExisting(`$env:CONTEXTUAL_RELEASE)
		`$child = [Diagnostics.Process]::Start([Diagnostics.ProcessStartInfo] @{ FileName = `$env:CONTEXTUAL_PROGRAM; Arguments = `$env:CONTEXTUAL_ARGUMENTS; UseShellExecute = `$false })
		`$child.WaitForExit()
		while (-not `$release.WaitOne(1000)) {
			if (-not (Get-Process -Id `$env:CONTEXTUAL_LAUNCHER -ErrorAction SilentlyContinue)) {
				break
			}
		}
		exit `$child.ExitCode
	"
	$env:CONTEXTUAL_PROGRAM = (Get-Command $env:CONTEXTUAL_PROGRAM).Source
	$env:CONTEXTUAL_ARGUMENTS = $commandLine -join " "
	$env:CONTEXTUAL_RELEASE = "Local\1p-contextual-$PID"
	$env:CONTEXTUAL_LAUNCHER = $PID
	$env:CONTEXTUAL_SUPERVISOR = $supervisor
	$env:CONTEXTUAL_SUPERVISE = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($supervise))
	$detach = "exit [Diagnostics.Process]::Start([Diagnostics.ProcessStartInfo] @{ FileName = `$env:CONTEXTUAL_SUPERVISOR; Arguments = `"-NoProfile -NonInteractive -EncodedCommand `$env:CONTEXTUAL_SUPERVISE`"; UseShellExecute = `$false }).Id"
	$detacher = [Diagnostics.Process]::Start([Diagnostics.ProcessStartInfo] @{
		FileName = "powershell.exe"
		Arguments = "-NoProfile -NonInteractive -EncodedCommand $([Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($detach)))"
		UseShellExecute = $false
	})
	$detacher.WaitForExit()
	$status = 255
	$supervising = Get-Process -Id $detacher.ExitCode -ErrorAction SilentlyContinue
	if ($supervising) {
		$null = $supervising.Handle
		$null = $release.Set()
		$supervising.WaitForExit()
		$status = $supervising.ExitCode
	}
	Remove-Item -LiteralPath $directory -Recurse -ErrorAction SilentlyContinue
	exit $status
'
